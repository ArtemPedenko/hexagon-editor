{
  "name": "@gravity-ui/vue-markdown-editor",
  "version": "0.1.0-alpha.0",
  "description": "Vue 3 Markdown/YFM WYSIWYG and markup editor",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
