    "@codemirror/view": "^6.36.0",
    "@floating-ui/dom": "^1.7.0",
    "@gravity-ui/icons": "^2.12.0",
    "katex": "^0.18.1",
    "markdown-it": "^14.1.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
